{
  "name": "personal-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@mastra/auth-workos": "1.6.7-alpha.0",
    "@mastra/code-sdk": "1.15.0-alpha.7",
    "@mastra/core": "1.79.0-alpha.6",
    "@mastra/e2b": "0.14.2-alpha.0",
    "@mastra/factory": "0.24.0-alpha.7",
    "@mastra/libsql": "1.27.0-alpha.3",
    "@mastra/memory": "1.39.0-alpha.5",
    "@mastra/pg": "1.32.0-alpha.3",
    "@mastra/platform-workspace": "1.8.2-alpha.0",
    "@mastra/redis-streams": "0.6.4-alpha.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.35.0-alpha.6",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
