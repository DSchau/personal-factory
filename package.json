{
  "name": "personal-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy",
    "slack:manifest": "node scripts/slack-manifest.mjs",
    "update:alpha": "pnpm add -E @mastra/auth-workos@alpha @mastra/code-sdk@alpha @mastra/core@alpha @mastra/e2b@alpha @mastra/factory@alpha @mastra/libsql@alpha @mastra/memory@alpha @mastra/pg@alpha @mastra/platform-workspace@alpha @mastra/redis-streams@alpha @mastra/slack@alpha && pnpm add -D -E mastra@alpha"
  },
  "dependencies": {
    "@mastra/auth-workos": "1.6.8-alpha.0",
    "@mastra/code-sdk": "1.16.0-alpha.8",
    "@mastra/core": "1.80.0-alpha.7",
    "@mastra/e2b": "0.15.1-alpha.1",
    "@mastra/factory": "0.26.0-alpha.0",
    "@mastra/libsql": "1.27.1-alpha.1",
    "@mastra/memory": "1.39.1-alpha.3",
    "@mastra/pg": "1.33.0-alpha.3",
    "@mastra/platform-workspace": "1.10.0-alpha.3",
    "@mastra/redis-streams": "0.7.0-alpha.2",
    "@mastra/slack": "1.8.0-alpha.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "1.37.0-alpha.0",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
