        "im:write",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "app_mentions:read",
        "users:read",
        "reactions:write",
        "files:read",
        "files:write",
        "assistant:write"
