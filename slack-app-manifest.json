      "always_online": true
    },
    "agent_view": {
      "agent_description": "AI assistant powered by Mastra"
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://dschau.tail9b165a.ts.net/connect/slack/oidc/callback"
    ],
    "scopes": {
