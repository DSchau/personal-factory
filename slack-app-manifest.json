    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://dschau.tail9b165a.ts.net/api/agent-controllers/mastra-code/channels/slack/webhook",
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "agent_session_stopped"
